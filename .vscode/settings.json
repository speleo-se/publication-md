{
	// Activity bar color, so this window is easy to tell apart from the others.
	// Red, to set publication-md apart from the content repos.
	//
	// Written for VS Code's Modern UI, which is on by default: modernActivityBar.*
	// paints the bar, and activityBar.inactiveForeground is the one classic key it
	// still reads. The other activityBar.* keys have no effect there, so none are set.
	"workbench.colorCustomizations": {
		"modernActivityBar.background": "#B3261E",
		"modernActivityBarItem.activeBackground": "#8B1D17",
		"modernActivityBarItem.activeForeground": "#FFFFFF",
		"modernActivityBarItem.hoverBackground": "#9F211A",
		"modernActivityBarItem.hoverForeground": "#FFFFFF",
		// Modern UI still reads this one classic key, for the unselected icons.
		"activityBar.inactiveForeground": "#ffffffb0"
	},
	// Show the content repos under content/<name> as their own repositories in Source Control.
	// They sit two levels down (and are gitignored here), beyond VS Code's default scan depth of 1.
	"git.autoRepositoryDetection": true,
	"git.repositoryScanMaxDepth": 2,
	// work/ holds render trees (page images), never a repo — don't spend time scanning it.
	"git.repositoryScanIgnoredFolders": ["node_modules", "work"],
	// Search the content repos too: content/* is gitignored here, and search honours .gitignore by
	// default. So ignore files are off for search, and the excludes below replace them.
	"search.useIgnoreFiles": false,
	"search.exclude": {
		"**/node_modules": true,
		"**/.git": true,
		"work": true,
		"**/*.pdf": true,
		"content/*/*-content/img": true,
		"content/*/tmp": true,
		"**/__pycache__": true
	},
	"workbench.editorAssociations": {
		"*.md": "vscode.markdown.preview.editor",
		"git:/**/*.md": "default"
	},
	// Keeps the worktree picker working when .claude/worktrees exists.
	"git.detectWorktrees": true
}
