{
	"name": "@speleo-se/publication-md",
	"version": "0.1.0",
	"description": "publication-md: a plain-text format (Markdown + YAML) for transcribed publications, with a reference library, tools and Claude Code skills.",
	"license": "MIT",
	"author": "Lasse Hellman",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/speleo-se/publication-md.git"
	},
	"type": "module",
	"exports": {
		".": "./lib/src/index.ts"
	},
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"content": "node tools/content.ts",
		"fetch": "node tools/fetch-sources.ts",
		"validate": "node tools/validate.ts",
		"extract-images": "node tools/extract-images.ts",
		"stats": "node tools/stats.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"refs": "node tools/refs.ts"
	},
	"dependencies": {
		"@hyzyla/pdfium": "^2.1.13",
		"@tvartom/pagesequence": "file:vendor/pagesequence",
		"jpeg-js": "^0.4.4",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.2",
		"ajv": "^8.20.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
